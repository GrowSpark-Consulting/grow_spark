# ─────────────────────────────────────────────────────────────────────────────
# Grow Spark Consulting — environment template
#
# Copy to .env.local and fill in real values. .env.local is gitignored; this
# file is committed and must never contain a real credential.
#
# Everything here is SERVER-ONLY except the one variable explicitly prefixed
# NEXT_PUBLIC_ at the bottom. Next.js inlines any NEXT_PUBLIC_* value into the
# browser bundle, so adding that prefix to anything below would publish the
# secret to every visitor. scripts/verify-seo.py scans the shipped HTML and
# every client chunk for exactly this mistake — run it after wiring these up.
# ─────────────────────────────────────────────────────────────────────────────


# ── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API

# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Settings → API → service_role key.
# Bypasses Row Level Security and can read/write every table. It is the single
# most sensitive value in this file. Server routes only — never send it to the
# browser, never log it, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Settings → Database → Connection string → "Transaction pooler".
# Use the POOLED string on port 6543, not the direct one on 5432. Serverless
# functions open a connection per invocation and will exhaust the direct
# connection limit under real traffic — it works in testing, then fails live.
# Format: postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=


# ── HubSpot ──────────────────────────────────────────────────────────────────
# Private App token: Settings → Integrations → Private Apps → your app → Auth.
#
# REQUIRED IN PRODUCTION for contact submissions to reach the CRM. The site is
# built to run without it — an unset token makes the sync return "skipped", so
# the form still stores the lead and still emails it, and the hubspot_* columns
# are simply left null. That is a safe degraded mode, not a healthy one: leads
# accumulate in Postgres and never appear in HubSpot, silently.
#
# Scopes:
#   crm.objects.contacts.read    - required, contact lookup
#   crm.objects.contacts.write   - required, contact create/update
#   crm.schemas.contacts.read    - required by scripts/hubspot-setup.mjs
#   crm.schemas.contacts.write   - required by scripts/hubspot-setup.mjs to
#                                  create the eight gs_* properties. Record
#                                  writes do NOT need it, so a token without
#                                  this scope syncs fine but cannot provision.
#   crm.objects.deals.write      - only when the booking forms create Deals
#
# Changing scopes issues a NEW token; update this value and Vercel when you do.
HUBSPOT_ACCESS_TOKEN=

# Optional — only needed if strategy/engagement submissions create a Deal.
# Find them under Settings → Objects → Deals → Pipelines.
HUBSPOT_DEAL_PIPELINE_ID=
HUBSPOT_DEAL_STAGE_ID=


# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Read by lib/email.ts. All server-side; none of these may be prefixed
# NEXT_PUBLIC_.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Envelope sender. Must be an address the SMTP account is allowed to send as,
# on a domain with SPF and DKIM records — otherwise notifications land in spam.
# The visitor's address is used as Reply-To, never as From: putting it in From
# fails SPF for growsparkconsulting.com.
SMTP_FROM="Grow Spark Consulting <noreply@growsparkconsulting.com>"

# Implicit TLS on 465, STARTTLS on 587. Port 465 enables this automatically.
SMTP_SECURE=false

# Inbox that receives new contact form notifications.
CONTACT_EMAIL=


# ── Spam protection (recommended) ────────────────────────────────────────────
# Cloudflare Turnstile — free. These endpoints are public, unauthenticated,
# write to a database and send email, so they will be found and abused.
TURNSTILE_SECRET_KEY=

# The Turnstile SITE key is designed to be public and must reach the browser
# to render the widget, so NEXT_PUBLIC_ is correct here. This is the only
# variable in this file that belongs in the client bundle.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=


# ── Razorpay (Founder Strategy Session payment) ─────────────────────────────
# Dashboard → Settings → API Keys. Test keys start with rzp_test_, Live keys
# with rzp_live_. Read server-side only (lib/razorpay.ts, lib/env.ts) — never
# prefix any of these NEXT_PUBLIC_. The Key ID is not secret by nature, but it
# still reaches the browser only via the /api/strategy-session response, never
# baked into the client bundle at build time.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Dashboard → Webhooks → add endpoint (/api/razorpay/webhook) → the secret
# shown at creation time. Required for the webhook route only; order creation
# and Checkout verification work without it.
RAZORPAY_WEBHOOK_SECRET=
