# ─────────────────────────────────────────────────────────────────────────────
# Grow Spark Consulting — environment template
#
# Copy to .env.local and fill in real values. .env.local is gitignored; this
# file is committed and must never contain a real credential.
#
# Everything here is SERVER-ONLY except the one variable explicitly prefixed
# NEXT_PUBLIC_ at the bottom. Next.js inlines any NEXT_PUBLIC_* value into the
# browser bundle, so adding that prefix to anything below would publish the
# secret to every visitor. scripts/verify-seo.py scans the shipped HTML and
# every client chunk for exactly this mistake — run it after wiring these up.
# ─────────────────────────────────────────────────────────────────────────────


# ── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API

# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Settings → API → service_role key.
# Bypasses Row Level Security and can read/write every table. It is the single
# most sensitive value in this file. Server routes only — never send it to the
# browser, never log it, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Settings → Database → Connection string → "Transaction pooler".
# Use the POOLED string on port 6543, not the direct one on 5432. Serverless
# functions open a connection per invocation and will exhaust the direct
# connection limit under real traffic — it works in testing, then fails live.
# Format: postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=


# ── HubSpot ──────────────────────────────────────────────────────────────────
# Settings → Integrations → Private Apps → your app → Auth
# Scopes required: crm.objects.contacts.read, crm.objects.contacts.write
# Add crm.objects.deals.write only if we create Deals for the strategy forms.
HUBSPOT_ACCESS_TOKEN=

# Optional — only needed if strategy/engagement submissions create a Deal.
# Find them under Settings → Objects → Deals → Pipelines.
HUBSPOT_DEAL_PIPELINE_ID=
HUBSPOT_DEAL_STAGE_ID=


# ── Email ────────────────────────────────────────────────────────────────────
# Pick ONE provider and fill in only that block.

# Option A — Resend (recommended: simplest on Vercel, good deliverability)
RESEND_API_KEY=

# Option B — your own SMTP server
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false

# Sender address. The domain needs SPF and DKIM DNS records or notifications
# land in spam regardless of which provider you chose.
MAIL_FROM="Grow Spark Consulting <noreply@growsparkconsulting.com>"

# Where new lead notifications are delivered. Comma-separate for several.
MAIL_TO_INTERNAL=


# ── Spam protection (recommended) ────────────────────────────────────────────
# Cloudflare Turnstile — free. These endpoints are public, unauthenticated,
# write to a database and send email, so they will be found and abused.
TURNSTILE_SECRET_KEY=

# The Turnstile SITE key is designed to be public and must reach the browser
# to render the widget, so NEXT_PUBLIC_ is correct here. This is the only
# variable in this file that belongs in the client bundle.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
